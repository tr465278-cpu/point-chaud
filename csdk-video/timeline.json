      "end": 13.191,
      "dur": 2.249
    },
    {
      "id": 9,
      "text": "nous croyons qu'une éducation de qualité peut changer une vie.",
      "start": 13.191,
      "end": 16.755,
      "dur": 3.564
    },
    {
      "id": 10,
      "text": "Ici, vos enfants apprennent avec discipline.",
      "start": 16.755,
      "end": 19.506,
      "dur": 2.751
    },
    {
      "id": 11,
      "text": "Grandissent avec confiance.",
      "start": 19.506,
      "end": 21.275,
      "dur": 1.769
    },
    {
      "id": 12,
      "text": "Et avancent vers la réussite.",
      "start": 21.275,
      "end": 23.365,
      "dur": 2.09
    },
    {
      "id": 13,
      "text": "Offrez à votre enfant un environnement pour apprendre,",
      "start": 23.365,
      "end": 26.819,
      "dur": 3.454
    },
    {
      "id": 14,
      "text": "s'épanouir, et construire son avenir.",
